DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=*
# Comma-separated frontend origins. Leave empty to allow all (fine for local dev).
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional: 1.0 = use OSRM durations unchanged; 1.1 = trucks ~10% slower than cars.
TRUCK_TIME_FACTOR=1.0
